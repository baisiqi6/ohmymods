<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable><DefineConstants>$(DefineConstants);KEM_HEAVY_SHIELD_SNAPSHOT_PURE_TESTS</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**</DefaultItemExcludes>
    <!-- RED run: -p:HeavyShieldSourceRoot=<product>/il2cpp ; GREEN (default): candidate il2cpp. -->
    <HeavyShieldSourceRoot Condition="'$(HeavyShieldSourceRoot)'==''">$(MSBuildThisFileDirectory)../../il2cpp</HeavyShieldSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldBlockPolicy.cs" Link="HeavyShieldBlockPolicy.cs" />
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldContracts.cs" Link="HeavyShieldContracts.cs" />
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldIdentity.cs" Link="HeavyShieldIdentity.cs" />
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldPersistence.cs" Link="HeavyShieldPersistence.cs" />
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldPromotionBridge.cs" Link="HeavyShieldPromotionBridge.cs" />
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldSaveData.cs" Link="HeavyShieldSaveData.cs" />
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldQuota.cs" Link="HeavyShieldQuota.cs" />
    <Compile Include="$(HeavyShieldSourceRoot)/HeavyShieldEnrollment.cs" Link="HeavyShieldEnrollment.cs"
             Condition="Exists('$(HeavyShieldSourceRoot)/HeavyShieldEnrollment.cs')" />
  <Compile Include="$(HeavyShieldSourceRoot)/Patch_HeavyShieldSnapshot.cs" Link="Patch_HeavyShieldSnapshot.cs" /></ItemGroup>
</Project>
