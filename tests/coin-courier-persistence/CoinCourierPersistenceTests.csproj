<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CoinCourierPersistenceTests</AssemblyName>
    <RootNamespace>CoinCourierPersistenceTests</RootNamespace>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <GeneratePropertiesFile>false</GeneratePropertiesFile>
    <!-- 同级 actual-interop 子项目及其 obj 生成码不得被卷进本测试程序集 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);actual-interop/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../il2cpp/CoinCourierSaveData.cs" Link="Production/CoinCourierSaveData.cs" />
    <Compile Include="../../il2cpp/CoinCourierPersistence.cs" Link="Production/CoinCourierPersistence.cs" />
    <Compile Include="../../il2cpp/CoinCourierCampaignState.cs" Link="Production/CoinCourierCampaignState.cs" />
    <Compile Include="../../il2cpp/CoinCourierPurse.cs" Link="Production/CoinCourierPurse.cs" />
  </ItemGroup>

</Project>
