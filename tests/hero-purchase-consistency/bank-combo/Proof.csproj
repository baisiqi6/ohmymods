<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>HeroBankComboTests</AssemblyName>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0162;CS8509;CS0067;CS0108</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Bank B worktree is the base for the bank production chain; only the listed files are used. -->
    <BankRoot>$(MSBuildThisFileDirectory)../../..</BankRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Harness.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="NativeStubs.cs" />
    <Compile Include="HeroStubs.cs" />
    <!-- The H-side SharedBankNative override and the hero rights gate, both linked as production. -->
    <Compile Include="$(BankRoot)/il2cpp/SharedBankNative.cs" />
    <Compile Include="$(BankRoot)/il2cpp/HeroNativeRights.cs" />
    <Compile Include="$(BankRoot)/il2cpp/SharedBankState.cs" />
    <Compile Include="$(BankRoot)/il2cpp/PatchEconomy_Banker.cs" />
    <Compile Include="$(BankRoot)/il2cpp/MainBankerFixedDomain.cs" />
    <Compile Include="$(BankRoot)/il2cpp/CoinCourierPurse.cs" />
    <Compile Include="$(BankRoot)/il2cpp/CoinCourierEconomy.cs" />
    <Compile Include="$(BankRoot)/il2cpp/CoinCourierRules.cs" />
    <Compile Include="$(BankRoot)/il2cpp/CoinCourierTargeting.cs" />
    <Compile Include="$(BankRoot)/il2cpp/CoinCourierBankScope.cs" />
    <Compile Include="$(BankRoot)/il2cpp/GreekBankScope.cs" />
    <Compile Include="$(BankRoot)/il2cpp/HeroRecruitmentArchive.cs" />
    <Compile Include="$(BankRoot)/il2cpp/HeroRecruitmentContext.cs" />
    <Compile Include="$(BankRoot)/il2cpp/HeroRecruitmentFingerprint.cs" />
  </ItemGroup>
</Project>
