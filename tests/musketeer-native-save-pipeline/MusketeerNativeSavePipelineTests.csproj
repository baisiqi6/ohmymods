<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The linked production file calls the unsafe il2cpp_field_get_value(IntPtr, IntPtr, void*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="../heavy-shield-boundary/DisabledHeavyShieldApis.cs" />
    <Compile Include="../../il2cpp/PatchPerf_CanonicalHashBuffer.cs" Condition="Exists('../../il2cpp/PatchPerf_CanonicalHashBuffer.cs')" />
    <Compile Include="../../il2cpp/MusketeerArchive.cs" />
    <Compile Include="../../il2cpp/MusketeerIdentity.cs" />
    <Compile Include="../../il2cpp/MusketeerPersistence.cs" />
    <Compile Include="../../il2cpp/MusketeerNativeArchive.cs" />
    <Compile Include="../../il2cpp/MusketeerPairedBackup.cs" />
    <Compile Include="../../il2cpp/Patch_MusketeerNativeSave.cs" />
    <Compile Include="../../il2cpp/Patch_MusketeerBoardingPolicy.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../il2cpp/Patch_MusketeerLegacyCompensation.cs" Link="Production/Patch_MusketeerLegacyCompensation.cs" />
    <Compile Include="../musketeer-boundary/DisabledLegacyCompensationRuntime.cs" Link="Boundary/DisabledLegacyCompensationRuntime.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../custom-shop-boundary/DisabledCustomShopStocks.cs" Link="Boundary/DisabledCustomShopStocks.cs" /></ItemGroup>
</Project>
