<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
    <NativeSaveSource Condition="'$(NativeSaveSource)' == ''">../../il2cpp/Patch_MusketeerNativeSave.cs</NativeSaveSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Reuse only the adapter's platform/value doubles and real payload shape builders.
         Neither its test Program nor a writer/compensation core substitute is linked. -->
    <Compile Include="../musketeer-native-save-adapter/Stubs.cs" Link="PlatformStubs.cs" />
    <Compile Include="../musketeer-native-save-adapter/Fixtures.cs" Link="PayloadFixtures.cs" />
    <Compile Include="../../il2cpp/MusketeerArchive.cs" Link="Production/MusketeerArchive.cs" />
    <Compile Include="../../il2cpp/MusketeerNativeArchive.cs" Link="Production/MusketeerNativeArchive.cs" />
    <Compile Include="../../il2cpp/MusketeerPairedBackup.cs" Link="Production/MusketeerPairedBackup.cs" />
    <Compile Include="../../il2cpp/Patch_MusketeerLegacyCompensation.cs" Link="Production/CompensationPolicy.cs" />
    <Compile Include="$(NativeSaveSource)" Link="Production/Patch_MusketeerNativeSave.cs" />
  </ItemGroup>
</Project>
