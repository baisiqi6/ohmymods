<Project Sdk="Microsoft.NET.Sdk">

  <!-- 控制台测试程序集：把生产 il2cpp/MapWidthPlanner.cs / MapWidthTerrain.cs / PatchWorld_Level.cs
       直接编译进来，并补 Unity/游戏/Harmony/ModConfig stub（Stubs.cs）。
       只验证规划器与 scope/桥接行为；真实 2.4 资产形状由 static 取证与真实 interop 构建约束，
       本目录不写游戏文件、不启动游戏、不部署。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MapWidthTests</AssemblyName>
    <RootNamespace>MapWidthTests</RootNamespace>
    <EnableDefaultItems>true</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../il2cpp/MapWidthPlanner.cs" Link="Production/MapWidthPlanner.cs" />
    <Compile Include="../../il2cpp/MapWidthTerrain.cs" Link="Production/MapWidthTerrain.cs" />
    <Compile Include="../../il2cpp/PatchWorld_Level.cs" Link="Production/PatchWorld_Level.cs" />
  </ItemGroup>

</Project>
