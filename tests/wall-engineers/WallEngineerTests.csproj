<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WallEngineerTests</AssemblyName>
    <RootNamespace>WallEngineerTests</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169</NoWarn>
    <!-- Only the two harness files here; the actual-interop subdirectory builds on its own. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../il2cpp/WallEngineerRules.cs" Link="Production/WallEngineerRules.cs" />
    <Compile Include="../../il2cpp/WallEngineerRuntime.cs" Link="Production/WallEngineerRuntime.cs" />
    <Compile Include="../../il2cpp/PatchWorld_WallEngineers.cs" Link="Production/PatchWorld_WallEngineers.cs" />
  </ItemGroup>

</Project>
