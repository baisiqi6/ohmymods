<Project Sdk="Microsoft.NET.Sdk">

  <!-- 控制台测试程序集：把生产 il2cpp/KnightIdentityRuntime.cs + KnightIdentityArchive.cs 与新 helper
       il2cpp/KnightIdentityLoadSeed.cs 直接编译进来，并补 native 边界 stub（NativeStubs.cs，复制自
       tests/knight-identity-runtime 并给 ObjectData 增加模拟 Pointer：真实 interop 里它继承 Il2CppObjectBase）。
       临时文件只写在 tests/knight-load-seed/bin/<cfg>/kls-tmp/<guid>/ 下，逐例删除，绝不扫别的目录。
       生产工程不引用本目录，本目录不改动任何原生存档、游戏文件或配置。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KnightLoadSeedTests</AssemblyName>
    <RootNamespace>KnightLoadSeedTests</RootNamespace>
    <EnableDefaultItems>true</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="interop/**" />
    <Compile Include="../../il2cpp/KnightIdentityLoadSeed.cs" Link="Production/KnightIdentityLoadSeed.cs" />
    <Compile Include="../../il2cpp/KnightIdentityRuntime.cs" Link="Production/KnightIdentityRuntime.cs" />
    <Compile Include="../../il2cpp/KnightIdentityArchive.cs" Link="Production/KnightIdentityArchive.cs" />
    <Compile Include="../../il2cpp/KnightIdentityContext.cs" Link="Production/KnightIdentityContext.cs" />
  </ItemGroup>

</Project>
