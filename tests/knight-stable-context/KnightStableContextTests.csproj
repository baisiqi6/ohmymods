<Project Sdk="Microsoft.NET.Sdk">

  <!-- 控制台测试程序集：把生产纯模型 il2cpp/KnightIdentityArchive.cs 与稳定上下文解析
       il2cpp/KnightIdentityContext.cs 直接编译进来（两者都不依赖 Unity / 游戏类型）。
       用例只吃 archive + rawJson 字符串，不做任何 I/O、不碰原生存档或游戏文件。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KnightStableContextTests</AssemblyName>
    <RootNamespace>KnightStableContextTests</RootNamespace>
    <EnableDefaultItems>true</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../il2cpp/KnightIdentityArchive.cs" Link="Production/KnightIdentityArchive.cs" />
    <Compile Include="../../il2cpp/KnightIdentityContext.cs" Link="Production/KnightIdentityContext.cs" />
  </ItemGroup>

</Project>
