<Project Sdk="Microsoft.NET.Sdk">

  <!-- 控制台测试程序集：把生产核心 il2cpp/HermesHeadwearCycle.cs 直接编译进来（单文件、无 Unity/BepInEx 依赖），
       以 HERMES_CYCLE_TEST 打开权限/路径 seam；所有临时文件只落在 bin/<cfg>/hermes-cycle-tmp/<guid>/ 内，逐例删除。
       生产工程（il2cpp/KingdomEnhancedMod.csproj）不引用本目录，本目录也不改动任何原生存档或游戏文件。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);HERMES_CYCLE_TEST</DefineConstants>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HermesHeadwearCycleTests</AssemblyName>
    <RootNamespace>HermesHeadwearCycleTests</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Harness.cs" />
    <Compile Include="CycleTests.cs" />
    <Compile Include="../../il2cpp/HermesHeadwearCycle.cs" Link="Production/HermesHeadwearCycle.cs" />
  </ItemGroup>

</Project>
