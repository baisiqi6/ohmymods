<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>HermesHeadwearVisualsTests</AssemblyName>
    <RootNamespace>HermesHeadwearVisualsTests</RootNamespace>
    <!-- Override when the production file lives somewhere else, e.g. -p:ProductionSource=<repo>/il2cpp/HermesHeadwearVisuals.cs -->
    <ProductionSource Condition="'$(ProductionSource)' == ''">../../il2cpp/HermesHeadwearVisuals.cs</ProductionSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionSource)" Link="Production/HermesHeadwearVisuals.cs" />
  </ItemGroup>
</Project>
