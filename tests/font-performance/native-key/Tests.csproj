<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DefineConstants>KEM_NATIVE_KEY_PURE_TEST</DefineConstants>
    <NoWarn>618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FakeAdapter.cs" />
    <Compile Include="SchemaShim.cs" />
    <Compile Include="../../../il2cpp/HeavyShieldNativeKeyReader.cs" />
    <Reference Include="$(BepInExRoot)/core/Il2CppInterop.Runtime.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(BepInExRoot)/interop/Il2Cppmscorlib.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ReferenceGuard" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExRoot)/core/Il2CppInterop.Runtime.dll')" Text="Pass -p:BepInExRoot=path/to/BepInEx with generated interop assemblies" />
  </Target>
  <Target Name="SchemaKeyGuard" BeforeTargets="BeforeCompile">
    <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../il2cpp/HeavyShieldSaveData.cs').Contains('KEM.HeavyShield.Campaigns.v1'))" Text="HeavyShieldSaveSchema.Key drift" />
  </Target>
</Project>
