<Project Sdk="Microsoft.NET.Sdk">

  <!-- issue-84 红测夹具（第1轮，仅测试；生产零改）。
       把 il2cpp/PatchDivine_FriendlyTroll.cs 直接编译进来（不复制被测逻辑），
       配最小 Unity / 游戏 / Harmony / Il2Cpp 替身与 KingdomEnhancedMod 协作替身。
       离线替身只服务本套件：Damageable.IsDamagedBy/ReceiveDamage 是按计划
       （位4=BoulderFriendly / 位8=BoulderEnemy / 位1=近战，mask+invulnerable
       门）写的模型，不是实际游戏执行，也不代表完整原生语义。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FriendlyTrollFriendlyFireTests</AssemblyName>
    <RootNamespace>FriendlyTrollFriendlyFireTests</RootNamespace>
    <EnableDefaultItems>true</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../il2cpp/PatchDivine_FriendlyTroll.cs"
             Link="Production/PatchDivine_FriendlyTroll.cs" />
  </ItemGroup>

</Project>
