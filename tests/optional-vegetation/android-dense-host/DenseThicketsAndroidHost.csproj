<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
    <AssemblyName>DenseThicketsAndroidHost</AssemblyName>
    <RootNamespace>DenseThicketsAndroidHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real shared production source compiled with ANDROID defined (the file-local
         Grass alias and the FX-seam cut are active) and the real android/OptionalQoLScope.cs,
         not a loose PC stub. The typed stubs in HostStubs.cs mirror the used interop surface
         (Il2Cpp.World/Grass/Managers/NetworkBigBoss/BiomeHolder + field accessors as
         properties, matching Il2CppInterop 1.5.1 namespace-prefix mode). -->
    <Compile Include="../../../il2cpp/PatchWorld_OptionalVegetation.cs" Link="Production/PatchWorld_OptionalVegetation.cs" />
    <Compile Include="../../../android/OptionalQoLScope.cs" Link="Adapter/OptionalQoLScope.cs" />
  </ItemGroup>
</Project>
