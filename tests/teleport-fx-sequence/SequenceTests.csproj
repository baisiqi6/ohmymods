<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <AssemblyName>TeleportFxSequenceTests</AssemblyName>
        <RootNamespace>TeleportFxSequenceTests</RootNamespace>
        <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
        <GeneratePropertiesFile>false</GeneratePropertiesFile>
        <CoinCourierTeleportFxSource Condition="'$(CoinCourierTeleportFxSource)'==''">../../il2cpp/CoinCourierTeleportFx.cs</CoinCourierTeleportFxSource>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AndroidFlipYTest)'=='true'">
        <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="$(CoinCourierTeleportFxSource)" Link="Production/CoinCourierTeleportFx.cs" />
        <Compile Include="../coin-courier-visuals/Stubs.cs" Link="Stubs.cs" />
        <Compile Include="../musketeer-runtime/AndroidTexturePixelsStub.cs" Link="AndroidTexturePixelsStub.cs" />
    </ItemGroup>
</Project>
