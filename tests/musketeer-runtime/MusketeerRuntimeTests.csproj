<Project Sdk="Microsoft.NET.Sdk">

  <!-- 控制台测试程序集：把生产文件（MusketeerAnimation/Combat/Runtime/Visuals/GunVisuals）直接编译进来，
       配 Unity/原生/协作 API 替身（UnityStubs.cs / NativeStubs.cs）。
       纯逻辑（动画时钟/冷却闸/命中选择/借用账本）用真实生产代码路径验证；
       真实 interop 签名核对在 interop-check/（引用 E 盘 2.4 interop 程序集编译）。
       生产工程（il2cpp/KingdomEnhancedMod.csproj）不引用本目录。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MusketeerRuntimeTests</AssemblyName>
    <RootNamespace>MusketeerRuntimeTests</RootNamespace>
    <EnableDefaultItems>true</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169</NoWarn>
    <MusketeerVisualsSource Condition="'$(MusketeerVisualsSource)'==''">../../il2cpp/MusketeerVisuals.cs</MusketeerVisualsSource>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AndroidFlipYTest)'=='true'">
    <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../il2cpp/CombatDamage.cs" Link="Production/CombatDamage.cs" />
    <Compile Include="../../il2cpp/MusketeerAnimation.cs" Link="Production/MusketeerAnimation.cs" />
    <Compile Include="../../il2cpp/MusketeerCombat.cs" Link="Production/MusketeerCombat.cs" />
    <Compile Include="../../il2cpp/MusketeerRuntime.cs" Link="Production/MusketeerRuntime.cs" />
    <Compile Include="$(MusketeerVisualsSource)" Link="Production/MusketeerVisuals.cs" />
    <Compile Include="../../il2cpp/MusketeerGunVisuals.cs" Link="Production/MusketeerGunVisuals.cs" />
    <Compile Include="../../il2cpp/AndroidUnityCompat.cs" Link="Production/AndroidUnityCompat.cs" />
    <Compile Include="../../il2cpp/CharacterLeisureClock.cs" Link="Production/CharacterLeisureClock.cs" />
    <Compile Include="../../il2cpp/CharacterLeisureAtlas.cs" Link="Production/CharacterLeisureAtlas.cs" />
    <EmbeddedResource Include="../../il2cpp/Assets/MusketeerLeisure.png" LogicalName="KingdomEnhancedMod.MusketeerLeisure.png" />
    <EmbeddedResource Include="../../il2cpp/Assets/MusketeerGun.png" LogicalName="KingdomEnhancedMod.MusketeerGun.png" />
    <Compile Remove="interop-check/**" />
  </ItemGroup>

</Project>
