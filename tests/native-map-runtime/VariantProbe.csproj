<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>VariantProbe</AssemblyName>
    <RootNamespace>RuntimeProbe</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0169;CS0649;CS0067;CS0414</NoWarn>
  <StartupObject>RuntimeProbe.VariantProbe</StartupObject></PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="GameStubs.cs" />
    <Compile Include="Png.cs" />

    <Compile Include="../../il2cpp/MapMountIcons.cs" />
    <Compile Include="../../il2cpp/MapExtensionIslandArt.cs" />
    <Compile Include="../../il2cpp/Patch_MountIslandArtVariant.cs" />
    <Compile Include="../../il2cpp/MapResourceIconPlan.cs" />
    <Compile Include="../../il2cpp/PatchExtensionIsland_Map.cs" />
    <Compile Include="../../il2cpp/Patch_MountIslandCompactLayout.cs" />
    <Compile Include="../../il2cpp/Patch_MountIslandMapLayout.cs" />
    <Compile Include="../../il2cpp/ExtensionIslandMapPlan.cs" />
    <Compile Include="../../il2cpp/Patch_MountIslandSplitPolicy.cs" />
    <Compile Include="CompatibilityStubs.cs" />
    <EmbeddedResource Include="../../il2cpp/Assets/KEM_MapExtensionIsland.png" LogicalName="KingdomEnhancedMod.KEM_MapExtensionIsland.png" />
    <EmbeddedResource Include="../../il2cpp/Assets/KEM_MapExtensionIslandCrescent.png" LogicalName="KingdomEnhancedMod.KEM_MapExtensionIslandCrescent.png" Condition="'$(IncludeCrescentResource)' != 'false'" />
  <Compile Include="VariantProbe.cs" />
    <Compile Include="../../il2cpp/CrossWorldMountData.cs" />
    <Compile Include="../../il2cpp/MapCustomIconPlan.cs" />
    <None Include="../native-map-icons/fixtures/icon-rects.json" CopyToOutputDirectory="PreserveNewest" TargetPath="icon-rects.json" /></ItemGroup>
</Project>
