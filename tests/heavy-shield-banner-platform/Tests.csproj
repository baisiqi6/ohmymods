<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>HeavyShieldBannerPlatformTests</AssemblyName>
    <!-- Mirrors the Android product define set: the Banner adapter takes the ANDROID boundary. -->
    <DefineConstants>ANDROID;IL2CPP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real adapter under test plus the real pure contracts/policy it links. -->
    <Compile Include="../../il2cpp/Patch_HeavyShieldBanner.cs" Link="Production/Patch_HeavyShieldBanner.cs" />
    <Compile Include="../../il2cpp/HeavyShieldContracts.cs" Link="Production/HeavyShieldContracts.cs" />
    <Compile Include="../../il2cpp/HeavyShieldQuota.cs" Link="Production/HeavyShieldQuota.cs" />
    <Compile Include="../../il2cpp/Patch_HeavyShieldBannerPolicy.cs" Link="Production/Patch_HeavyShieldBannerPolicy.cs" />
    <!-- Boundary fixtures only: every member counts and throws when a path reads native state. -->
    <Compile Include="NativeFixtures.cs" />
    <Compile Include="ModFixtures.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
