+    // VM_FLAGS_FIXED reserves an exact free range; unlike mmap MAP_FIXED,
+    // it does not replace an existing mapping (no VM_FLAGS_OVERWRITE).
+    mach_vm_address_t reserved = (mach_vm_address_t)address;
+    kern_return_t kr = mach_vm_allocate(mach_task_self(), &reserved, size, VM_FLAGS_FIXED);
+    if (kr != KERN_SUCCESS)
+      return nullptr;
+    if (reserved != (mach_vm_address_t)address || mprotect((void *)reserved, size, prot) != 0) {
+      mach_vm_deallocate(mach_task_self(), reserved, size);
+      return nullptr;
+    }
+    return (void *)reserved;
   }
+#endif
+  int flags = MAP_PRIVATE | MAP_ANONYMOUS;
+  // Do not replace an existing mapping while reserving a near-code page.
+  // Treat the requested address as a hint and accept only that exact free address.
   void *result = mmap(address, size, prot, flags, kMmapFd, kMmapFdOffset);
   if (result == MAP_FAILED)
     return nullptr;
+  if (address != nullptr && result != address) {
+    munmap(result, size);
+    return nullptr;
+  }
 
   return result;
 }
