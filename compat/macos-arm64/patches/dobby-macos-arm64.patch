--- /dev/null
+++ b/source/MemoryAllocator/NearGapSelection.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// Policy only: inputs are full-page gaps clipped to the branch window.
+// This helper never reserves or writes memory.
+namespace arm64_near_gap {
+struct Gap { uintptr_t low, high; };
+struct Candidate { uintptr_t start, end, nearest, distance; };
+inline std::vector<Candidate> Rank(const std::vector<Gap> &gaps, uintptr_t source,
+                                   uintptr_t page_size, uintptr_t block_pages) {
+  std::vector<Candidate> result;
+  if (!page_size || !block_pages || block_pages > UINTPTR_MAX / page_size) return result;
+  uintptr_t block_size = block_pages * page_size;
+  for (const auto &gap : gaps) {
+    if (gap.high <= gap.low || gap.high - gap.low < page_size ||
+        gap.low % page_size || gap.high % page_size) continue;
+    uintptr_t start = gap.low, nearest = gap.low;
+    if (gap.high <= source) {
+      nearest = gap.high - page_size;
+      start = gap.high - std::min(block_size, gap.high - gap.low);
+    } else if (gap.low < source) {
+      // A real executable source is mapped, but keep synthetic inputs bounded.
+      nearest = source - source % page_size;
+      if (nearest > gap.high - page_size) nearest = gap.high - page_size;
+      start = std::max(gap.low, std::min(nearest, gap.high - std::min(block_size, gap.high - gap.low)));
+    }
+    uintptr_t distance = nearest >= source ? nearest - source : source - nearest;
+    result.push_back({start, gap.high, nearest, distance});
+  }
+  std::sort(result.begin(), result.end(), [](const Candidate &a, const Candidate &b) {
+    return a.distance < b.distance || (a.distance == b.distance && a.start < b.start);
+  });
+  return result;
+}
