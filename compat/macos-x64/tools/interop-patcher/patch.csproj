<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <!-- Mono.Cecil 引用外部 BepInEx core 目录：由 build.sh 通过 -p:BepInExCoreDir=<绝对路径> 传入，
       不复制、不内嵌；缺失或指向错误时立即失败，避免静默解析到无效路径。 -->
  <Target Name="CheckBepInExCoreDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(BepInExCoreDir)' == ''"
           Text="BepInExCoreDir 未设置：请传 -p:BepInExCoreDir=/path/to/BepInEx/core（build.sh 已统一传入）。" />
    <Error Condition="'$(BepInExCoreDir)' != '' and !Exists('$(BepInExCoreDir)/Mono.Cecil.dll')"
           Text="BepInExCoreDir 下找不到 Mono.Cecil.dll：$(BepInExCoreDir)" />
  </Target>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(BepInExCoreDir)/Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
