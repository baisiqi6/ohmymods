+  addr_t window_end = ALIGN_FLOOR(addr_add(position, (addr_t)alloc_range), page_size);
+  if (window_end < page_size)
+    return;
+  addr_t last_reservable_page = window_end - page_size;
+  if (first_page_addr > last_reservable_page)
+    return;
+
+  addr_t page = first_page_addr;
+  for (int count = 1; count < kNearCodeReservePageLimit; ++count) {
+    addr_t next = addr_add(page, page_size);
