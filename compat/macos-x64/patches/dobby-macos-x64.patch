+static const int kNearCodeReservePageLimit = 16;
+
+// A fresh near code page is taken from the first free page of a gap, and the
+// caller reuses the page it holds instead of asking the kernel again. Try
+// to reserve still-free successors now, before another runtime fills the gap:
+// one page per OSMemory::Allocate call, fixed address, no overwrite, each page
+// pushed on its own so the arena keeps one-page granularity and the real page
+// size. The batch stops at the first page the kernel refuses, which leaves the
+// page already reserved by the search untouched, and it is bounded so a
+// foreign mapping that fills the gap costs at most one refused call.
+//
+// The offsets are checked like the search itself: no address overflow, never a
+// page at or past the strict alloc_range distance, never a page crossing the
+// full-page boundary that ends the window.
+static void reserve_near_code_successor_pages(addr_t first_page_addr, addr_t position, size_t alloc_range) {
+  const addr_t page_size = (addr_t)OSMemory::AllocPageSize();
+  if (page_size == 0 || alloc_range == 0)
+    return;
