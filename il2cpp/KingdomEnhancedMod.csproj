<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="ProjectSettings.shared.props" />

    <PropertyGroup>
        <AssemblyName>KingdomEnhancedMod</AssemblyName>
        <Description>Kingdom Enhanced Mod — IL2CPP (BepInEx 6) port of the UMM Mono mod</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>KingdomEnhancedMod</RootNamespace>
        <Configurations>Debug;BIE6_IL2CPP;BIE6_Mono</Configurations>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Version>4.0.0</Version>
        <!-- 并行 worker 各用独立 obj/<组>/ 时，默认通配会把其他组的生成代码（MyPluginInfo/AssemblyInfo）
             卷进来导致 CS0579/CS0101/CS0229 重复定义。排除一切 obj/ 目录。 -->
        <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**</DefaultItemExcludes>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    </ItemGroup>

