<Project>
    <!-- 跨架构配置：Debug/BIE6_IL2CPP/Release → net6.0 + IL2CPP 宏；BIE6_Mono → netstandard2.1 + MONO 宏
         （抄自 KingdomMod/ProjectSettings.shared.props，去掉了 MinVer 版本号机制） -->
    <PropertyGroup>
        <!-- Explicit game interop version; never auto-detected. Supported: 2.4.0 (default), 2.4.3. -->
        <GameInteropVersion Condition="'$(GameInteropVersion)' == ''">2.4.0</GameInteropVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <TargetFramework>net6.0</TargetFramework>
        <DefineConstants>IL2CPP,BIE,BIE6</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='BIE6_IL2CPP|AnyCPU'">
        <TargetFramework>net6.0</TargetFramework>
        <DefineConstants>IL2CPP,BIE,BIE6</DefineConstants>
    </PropertyGroup>
    <!-- 交付用 Release：与 Debug/BIE6_IL2CPP 相同的 IL2CPP 引用与宏，仅开启优化。
         标准 Configuration 名便于消费者直接使用 -c Release；本仓库无其他 il2cpp Release 消费者。 -->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <TargetFramework>net6.0</TargetFramework>
        <DefineConstants>IL2CPP,BIE,BIE6</DefineConstants>
        <Optimize>true</Optimize>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='BIE6_Mono|AnyCPU'">
        <TargetFramework>netstandard2.1</TargetFramework>
        <DefineConstants>MONO,BIE,BIE6</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GameInteropVersion)' == '2.4.3'">
        <DefineConstants>$(DefineConstants);KTC_GAME_243</DefineConstants>
    </PropertyGroup>

    <!-- 版本与配置宏在 CoreCompile 前按最终属性校验。GameInteropVersion 若在 Import 之后被 wrapper
         赋值，上面的 KTC_GAME_243 条件组已经错过，不能只靠求值顺序保证。 -->
    <Target Name="KTCValidateGameInteropVersion" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_KTCNormalizedDefines>;$(DefineConstants.Replace(',', ';').Replace(' ', ''));</_KTCNormalizedDefines>
        </PropertyGroup>
        <Error Condition="'$(GameInteropVersion)' != '2.4.0' and '$(GameInteropVersion)' != '2.4.3'"
               Text="Unsupported GameInteropVersion '$(GameInteropVersion)'. Supported values: 2.4.0, 2.4.3." />
        <Error Condition="'$(GameInteropVersion)' == '2.4.3' and !$(_KTCNormalizedDefines.Contains(';KTC_GAME_243;'))"
               Text="GameInteropVersion 2.4.3 requires the KTC_GAME_243 compile symbol, but DefineConstants is '$(DefineConstants)'. Set GameInteropVersion before importing ProjectSettings.shared.props, or pass it on the MSBuild command line." />
        <Error Condition="'$(GameInteropVersion)' == '2.4.0' and $(_KTCNormalizedDefines.Contains(';KTC_GAME_243;'))"
               Text="GameInteropVersion 2.4.0 must not define KTC_GAME_243, but DefineConstants is '$(DefineConstants)'." />
        <Error Condition="'$(Configuration)' == 'Release' and '$(Optimize)' != 'true'"
               Text="Release must set Optimize=true; got '$(Optimize)'." />
        <Error Condition="'$(Configuration)' == 'Release' and !$(_KTCNormalizedDefines.Contains(';IL2CPP;'))"
               Text="Release must compile the IL2CPP configuration; missing IL2CPP in '$(DefineConstants)'." />
        <Error Condition="'$(Configuration)' == 'Release' and !$(_KTCNormalizedDefines.Contains(';BIE;'))"
               Text="Release must define BIE; got '$(DefineConstants)'." />
        <Error Condition="'$(Configuration)' == 'Release' and !$(_KTCNormalizedDefines.Contains(';BIE6;'))"
               Text="Release must define BIE6; got '$(DefineConstants)'." />
    </Target>
</Project>
